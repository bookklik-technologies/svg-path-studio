{
  "name": "@bookklik/svg-path-studio",
  "version": "0.2.2",
  "description": "Zero-dependency SVG path engine and headless editor — parse, transform and optimize path data, with undo/redo state for custom editor UIs. TypeScript, ESM, Node.js and browsers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/svg-path-studio.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bookklik-technologies/svg-path-studio#readme",
  "bugs": {
    "url": "https://github.com/bookklik-technologies/svg-path-studio/issues"
  },
  "keywords": [
    "svg",
    "path",
    "editor",
    "headless",
    "embed",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
